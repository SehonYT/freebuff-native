#!/data/data/com.termux/files/usr/bin/bash
# freebuff-native git shim.
#
# The CLI's post-prompt repo scan spawns "git diff --cached ..." with its
# stdio on sockets that are not drained while the CLI waits for exit.
# Outside a repository, git responds with a multi-KB usage dump and blocks
# mid-write when the socket buffer fills - deadlocking the whole UI.
# Inside a repository the same command is silent, so this only bites in
# non-repo directories ($HOME included).
#
# For "diff" outside a repository, answer instantly with an empty result -
# which is the honest answer, since there is no repository to diff - and
# pass everything else (including --no-index) to the real git untouched.

REAL_GIT="${FREEBUFF_REAL_GIT:-/data/data/com.termux/files/usr/bin/git}"
[ -x "$REAL_GIT" ] || REAL_GIT="$(command -v git)"

# locate the diff subcommand (also covers "git -C <path> diff ...")
SUB=""
for a in "$@"; do
  case "$a" in -*) continue ;; *) [ -z "$SUB" ] && SUB="$a"; break ;; esac
done
if [ "$SUB" = "diff" ]; then
  case " $* " in
    *"--no-index"*) exec "$REAL_GIT" "$@" ;;
  esac
  if ! "$REAL_GIT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    exit 0
  fi
fi
exec "$REAL_GIT" "$@"
